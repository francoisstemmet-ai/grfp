# ============================================================================
# SA Food Merchants - www.grfp.co.za
# Apache configuration for the Plesk server
#
# Redirects (HTTP -> HTTPS and apex -> www) are configured in the Plesk
# control panel, NOT here - see the note further down for why.
# ============================================================================

# ---------------------------------------------------------------------------
# DEFAULT CHARSET
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8

DirectoryIndex index.html index.php

# ---------------------------------------------------------------------------
# HTTPS + CANONICAL HOST  --  DELIBERATELY NOT HANDLED HERE
#
# Plesk owns these two redirects, and adding them again in .htaccess causes
# an infinite redirect loop:
#
#   * Plesk "Preferred domain"  : www.grfp.co.za  -> grfp.co.za
#   * Plesk "Redirect HTTP->HTTPS": forces TLS at the nginx layer
#
# A rewrite here would push grfp.co.za back to www.grfp.co.za while Plesk
# pushes it the other way, and the browser gives up with "too many redirects".
#
# It also cannot detect TLS correctly: Plesk's nginx proxies to Apache over
# plain HTTP on loopback, so %{HTTPS} reads "off" even for a genuine HTTPS
# request unless X-Forwarded-Proto is propagated.
#
# Configure both in Plesk instead:
#   Websites & Domains -> grfp.co.za -> Domain settings
#     - Preferred domain       : www.grfp.co.za
#     - SSL/TLS support        : Full  (with a certificate selected)
#     - Redirect HTTP -> HTTPS : enabled
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CUSTOM ERROR DOCUMENT
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# BLOCK ACCESS TO JUNK / SOURCE FILES
# The WordPress/Divi leftovers from the previous site are no longer part of
# the deploy tree. These rules are a safety net in case an old file is ever
# uploaded alongside this structure by mistake.
# ---------------------------------------------------------------------------
<FilesMatch "\.(download|log|sql|bak|ini|sh|md)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(common|divi-mobile|jquery|jquery-migrate|scripts|smoothscroll)\.">
  Require all denied
</FilesMatch>

# Deny hidden files and directories (.git, .env, ...)
# .well-known is exempt: cPanel/Let's Encrypt needs it for SSL renewal.
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# Don't serve directory listings
Options -Indexes

# ---------------------------------------------------------------------------
# COMPRESSION
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# BROWSER CACHING
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# SECURITY HEADERS
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# MIME TYPES (Apache 2.4 hosts occasionally miss .svg / .webp)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml                 .svg
  AddType image/webp                    .webp
  AddType font/woff2                    .woff2
</IfModule>
